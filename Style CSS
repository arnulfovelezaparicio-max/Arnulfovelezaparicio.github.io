* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background-color: #f7f8f6;
    color: #171a18;
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

main {
    max-width: 900px;
    margin: auto;
    padding: 60px 25px;
}

h1 {
    font-size: 48px;
    margin-bottom: 10px;
}

h2 {
    margin-top: 60px;
    color: #176b3a;
}

p {
    color: #555;
    font-size: 18px;
}

button {
    background-color: #176b3a;
    color: white;
    border: none;
    padding: 13px 22px;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background-color: #12572f;
}

section {
    margin-top: 40px;
    padding: 25px;
    background-color: white;
    border-radius: 10px;
}

/* Project */

.project {
    border: 1px solid #e1e4e1;
    padding: 20px;
    border-radius: 8px;
    margin-top: 20px;
}

.project h3 {
    margin-top: 0;
    font-size: 24px;
}

.project-number {
    color: #176b3a;
    font-size: 13px;
    font-weight: bold;
}

.status {
    color: #176b3a;
    font-size: 14px;
    font-weight: bold;
}

/* Hero */

.hero {
    padding: 80px 0 40px;
}

.eyebrow {
    color: #176b3a;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: 56px;
    margin: 10px 0;
}

.hero p {
    max-width: 600px;
}

.hero button {
    margin-top: 15px;
}

/* Mobile */

@media (max-width: 600px) {

    main {
        padding: 40px 20px;
    }

    h1 {
        font-size: 38px;
    }

    p {
        font-size: 16px;
    }

    section {
        padding: 20px;
    }
}
